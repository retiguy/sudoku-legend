<?xml version="1.0" encoding="utf-8" standalone="no"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:versionCode="1" android:versionName="1.0" package="com.sudokulegend.game">
        
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="28"/>
        
    <queries>
                
        <package android:name="com.itsaky.androidide"/>
            
    </queries>
        
    <uses-permission android:name="android.permission.INTERNET"/>
        
    <uses-permission android:name="com.itsaky.androidide.permission.BIND_LOG_SERVICE"/>
        
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
        
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
        
    <application android:allowBackup="true" android:debuggable="true" android:extractNativeLibs="false" android:icon="@mipmap/sudoku_legend_icon" android:label="Sudoku Legend" android:roundIcon="@mipmap/sudoku_legend_icon" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:usesCleartextTraffic="false">
                
        <activity android:exported="true" android:name="com.sudokulegend.game.MainActivity" android:screenOrientation="portrait">
                        
            <intent-filter>
                                
                <action android:name="android.intent.action.MAIN"/>
                                
                <category android:name="android.intent.category.LAUNCHER"/>
                            
            </intent-filter>
                    
        </activity>
                
        <provider android:authorities="com.sudokulegend.game.logsender-installer" android:enabled="@bool/logsender_enabled" android:exported="false" android:name="com.itsaky.androidide.logsender.utils.LogSenderInstaller"/>
                
        <service android:exported="false" android:foregroundServiceType="dataSync" android:name="com.itsaky.androidide.logsender.LogSenderService"/>
            
    </application>
    
</manifest>
